<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette. Every color used anywhere in the app resolves
         through one of these DynamicResource keys - never a hard-coded
         Color/Brush in a View - so switching to Colors.Dark.xaml (see
         App.xaml.cs.ApplySystemTheme) changes the whole application
         consistently. -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#D8D8D8" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5B5B5B" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#0057B8" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#00449A" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Success" Color="#1E7B34" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#8A5A00" />
    <SolidColorBrush x:Key="Brush.Error" Color="#B3261E" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="#A6A6A6" />
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#E9EEF6" />
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#D6E4F7" />
    <SolidColorBrush x:Key="Brush.FocusVisual" Color="#0057B8" />

</ResourceDictionary>
