<UserControl x:Class="SceneForge.App.Views.WelcomeImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:SceneForge.App.Behaviors"
             mc:Ignorable="d"
             d:DesignWidth="900"
             MaxWidth="900"
             HorizontalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        <TextBlock Text="Import your media" Style="{StaticResource Heading1}" />
        <TextBlock Style="{StaticResource {x:Type TextBlock}}"
                   Margin="0,0,0,20"
                   Text="Choose a source video and a background audio track. Drag and drop a file onto either box, or use Browse." />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    behaviors:DragDropImportBehavior.DropCommand="{Binding VideoImportCommand}"
                    AutomationProperties.Name="Source video drop zone">
                <StackPanel>
                    <TextBlock Text="Source video" Style="{StaticResource Heading2}" />
                    <TextBlock Text="{Binding VideoSummary, TargetNullValue='No video selected yet.'}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Margin="0,0,0,12"
                                 Visibility="{Binding IsProbingVideo, Converter={StaticResource NullToVisibilityConverter}}" />
                    <Button Content="Browse for video..."
                            Command="{Binding BrowseVideoCommand}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Browse for a source video file" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource Card}"
                    behaviors:DragDropImportBehavior.DropCommand="{Binding AudioImportCommand}"
                    AutomationProperties.Name="Background audio drop zone">
                <StackPanel>
                    <TextBlock Text="Background audio" Style="{StaticResource Heading2}" />
                    <TextBlock Text="{Binding AudioSummary, TargetNullValue='No audio selected yet.'}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Margin="0,0,0,12"
                                 Visibility="{Binding IsProbingAudio, Converter={StaticResource NullToVisibilityConverter}}" />
                    <Button Content="Browse for audio..."
                            Command="{Binding BrowseAudioCommand}"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Browse for a background audio file" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorText}"
                   Margin="0,16,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                   AutomationProperties.LiveSetting="Assertive" />

        <Button Content="Continue"
                Command="{Binding ContinueCommand}"
                HorizontalAlignment="Right"
                Margin="0,24,0,0"
                AutomationProperties.Name="Continue to analysis settings" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
