<UserControl x:Class="SceneForge.App.Views.SceneReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:behaviors="clr-namespace:SceneForge.App.Behaviors"
             xmlns:vm="clr-namespace:SceneForge.App.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ClipReviewItemViewModel}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="150" Height="84"
                        Background="{DynamicResource Brush.WindowBackground}"
                        CornerRadius="4"
                        Margin="0,0,12,0">
                    <Grid>
                        <TextBlock Text="No preview"
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
                        <Image Source="{Binding Thumbnail}"
                               Stretch="UniformToFill"
                               behaviors:LazyThumbnailLoader.IsEnabled="True"
                               AutomationProperties.Name="Clip thumbnail" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock>
                        <Run Text="{Binding Clip.Range.Start, Converter={StaticResource TimeSpanToClockStringConverter}, Mode=OneWay}" />
                        <Run Text=" – " />
                        <Run Text="{Binding Clip.Range.End, Converter={StaticResource TimeSpanToClockStringConverter}, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Start" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="82"
                                 Text="{Binding AdjustedStart, Converter={StaticResource EditableTimeSpanConverter}, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="Adjusted clip start" />
                        <TextBlock Text="End" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <TextBox Width="82"
                                 Text="{Binding AdjustedEnd, Converter={StaticResource EditableTimeSpanConverter}, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="Adjusted clip end" />
                    </StackPanel>
                    <TextBlock Text="Boundary must stay within the detected clip and start before it ends."
                               Style="{StaticResource ErrorText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsBoundaryValid, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Caption}" Text="Entering transition" />
                    <TextBlock Visibility="{Binding LeadingTransition, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="{Binding LeadingTransition.Type, Converter={StaticResource EnumToSpacedStringConverter}, Mode=OneWay}" />
                        <Run Text=" (" />
                        <Run Text="{Binding LeadingTransition.Confidence, Converter={StaticResource ConfidenceToPercentStringConverter}, Mode=OneWay}" />
                        <Run Text=")" />
                    </TextBlock>
                    <TextBlock Text="Scene start" Visibility="{Binding LeadingTransition, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />

                    <TextBlock Style="{StaticResource Caption}" Text="Exiting transition" Margin="0,8,0,0" />
                    <TextBlock Visibility="{Binding TrailingTransition, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="{Binding TrailingTransition.Type, Converter={StaticResource EnumToSpacedStringConverter}, Mode=OneWay}" />
                        <Run Text=" (" />
                        <Run Text="{Binding TrailingTransition.Confidence, Converter={StaticResource ConfidenceToPercentStringConverter}, Mode=OneWay}" />
                        <Run Text=")" />
                    </TextBlock>
                    <TextBlock Text="Scene end" Visibility="{Binding TrailingTransition, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" />
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="Automatically accepted"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Success}"
                               Visibility="{Binding WasAutomaticallyAccepted, Converter={StaticResource NullToVisibilityConverter}}" />
                    <TextBlock Text="Automatically rejected"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Error}"
                               Visibility="{Binding WasAutomaticallyAccepted, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                               ToolTip="{Binding ScoreReasons[7].Detail}" />
                </StackPanel>

                <CheckBox Grid.Column="4"
                          Content="Include"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsIncluded}"
                          AutomationProperties.Name="Include this clip in the timeline" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Review candidate clips" Style="{StaticResource Heading1}" />
            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorText}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
            <TextBlock AutomationProperties.LiveSetting="Polite">
                <Run Text="{Binding IncludedCount, Mode=OneWay}" />
                <Run Text=" of " />
                <Run Text="{Binding TotalCount, Mode=OneWay}" />
                <Run Text=" clips included" />
            </TextBlock>
        </StackPanel>

        <!-- VirtualizingPanel.VirtualizationMode="Recycling" (set on the
             ListView implicit style, Themes/Styles.xaml) means only rows
             actually scrolled into view ever get a live container/thumbnail
             - see ClipReviewItemViewModel and Behaviors.LazyThumbnailLoader. -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Clips}"
                  AutomationProperties.Name="Candidate clip list" />

        <Button Grid.Row="2"
                Content="Continue"
                Command="{Binding ContinueCommand}"
                HorizontalAlignment="Right"
                Margin="0,16,0,0"
                AutomationProperties.Name="Continue to timeline summary" />
    </Grid>
</UserControl>
