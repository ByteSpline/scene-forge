<UserControl x:Class="SceneForge.App.Views.RenderProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="900"
             MaxWidth="900"
             HorizontalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
        <TextBlock Text="Rendering your video" Style="{StaticResource Heading1}" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource Heading2}"
                           AutomationProperties.LiveSetting="Polite" />

                <ProgressBar Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Height="12"
                             Margin="0,8,0,16" />

                <UniformGrid Columns="2" Margin="0,0,0,20">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Estimated time remaining" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding EstimatedTimeRemaining, Converter={StaticResource TimeSpanToClockStringConverter}, TargetNullValue='Calculating...'}" Style="{StaticResource MetricValue}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Encoding speed" Style="{StaticResource Caption}" />
                        <TextBlock Style="{StaticResource MetricValue}">
                            <Run Text="{Binding SpeedMultiplier, StringFormat={}{0:0.0}, TargetNullValue='—', Mode=OneWay}" />
                            <Run Text="x realtime" />
                        </TextBlock>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ErrorText}"
                           Margin="0,0,0,12"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                           AutomationProperties.LiveSetting="Assertive" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsRunning, Converter={StaticResource NullToVisibilityConverter}}"
                            AutomationProperties.Name="Cancel render"
                            Margin="0,0,8,0" />
                    <Button Content="Retry"
                            Command="{Binding RunCommand}"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"
                            AutomationProperties.Name="Retry render" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
